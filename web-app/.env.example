# Public
NEXT_PUBLIC_GITHUB_URL=https://github.com/l0t73ry/verithesis
NEXT_PUBLIC_OUTLAYER_ENABLED=false

# Attestation — pin deploy revision (Vercel sets VERCEL_GIT_COMMIT_SHA automatically)
VERITHESIS_CODE_MEASUREMENT=

# OutLayer coordinator (server only — required when tee: true)
