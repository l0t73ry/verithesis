# Public
NEXT_PUBLIC_GITHUB_URL=https://github.com/l0t73ry/verithesis
NEXT_PUBLIC_OUTLAYER_ENABLED=false

# Attestation — pin deploy revision (Vercel sets VERCEL_GIT_COMMIT_SHA automatically)
VERITHESIS_CODE_MEASUREMENT=

# OutLayer coordinator (server only — required when tee: true)
# Local mock: npm run mock:outlayer → http://127.0.0.1:8791 + demo.near/verithesis
OUTLAYER_API_URL=
OUTLAYER_PROJECT_ID=
OUTLAYER_PAYMENT_KEY=

# Sealed strategy bias (server only)
VERITHESIS_SEALED_BIAS=0.08

# Optional hardening / tuning (server only) — see docs/attestation-runbook.md
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com   # override NEAR Mainnet JSON-RPC endpoint
# GITHUB_TOKEN=            # recommended on Vercel: shared egress IPs exhaust the anonymous GitHub limit
# VERITHESIS_EXPECTED_WASM_SHA256=   # pin the WASI module (hex sha256)
# VERITHESIS_DISABLE_DEMO_PAYMENT=1  # turn off the demo paywall unlock
# VERITHESIS_RATE_LIMIT_RERUN_PER_MIN=20
# VERITHESIS_RATE_LIMIT_TEE_PER_MIN=6
# VERITHESIS_RATE_LIMIT_VERIFY_PER_MIN=10
