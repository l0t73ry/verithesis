# web-app — copy to web-app/.env.local
NEXT_PUBLIC_GITHUB_URL=https://github.com/l0t73ry/verithesis
VERITHESIS_CODE_MEASUREMENT=git:your-commit-sha

# OutLayer (production TEE)
NEXT_PUBLIC_OUTLAYER_ENABLED=false
NEXT_PUBLIC_OUTLAYER_API_URL=https://api.outlayer.ai
OUTLAYER_API_URL=
OUTLAYER_PROJECT_ID=your-account.near/verithesis
OUTLAYER_PAYMENT_KEY=

